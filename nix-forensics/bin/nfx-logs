#!/usr/bin/env bash
# nfx-logs - log inventory, gaps, cleared/truncated logs, journald health, audit summary
set -u
NFX_TOOL="nfx-logs"
_nfx_self="$0"
while [ -L "$_nfx_self" ]; do
  _t=$(readlink "$_nfx_self"); case "$_t" in /*) _nfx_self="$_t" ;; *) _nfx_self="$(dirname "$_nfx_self")/$_t" ;; esac
done
# shellcheck source=../lib/nfx-common.sh
. "$(cd "$(dirname "$_nfx_self")/../lib" && pwd)/nfx-common.sh"

usage() {
  cat <<'USAGE'
nfx-logs - log source inventory and anti-forensics checks: empty/truncated logs, logging gaps,
symlinked logs, journald integrity, recent errors, auditd summary, unified log erasure (macOS).

Usage: nfx-logs [--since SPEC] [--gap HOURS] [--grep REGEX] [-o FILE] [--no-color]
  --since SPEC   window for recent-error/journal sampling (default 24h)
  --gap HOURS    flag time gaps in journald/syslog longer than this many hours (default 6)
  --grep REGEX   also print matching lines from the main logs within the window

ATT&CK: T1070.002 (Clear Linux or Mac System Logs), T1562.001 (Impair Defenses),
T1070.003 (Clear Command History - see nfx-shellhist), T1562.006 (Indicator Blocking).
USAGE
}
SINCE="24h"; GAP=6; GREP=""
nfx_std_args "$@"
set -- "${NFX_ARGS[@]+"${NFX_ARGS[@]}"}"
while [ $# -gt 0 ]; do case "$1" in --since) SINCE="$2"; shift ;; --gap) GAP="$2"; shift ;; --grep) GREP="$2"; shift ;; *) nfx_die "unknown option: $1";; esac; shift; done
mins=$(nfx_since_to_minutes "$SINCE"); now=$(nfx_now_epoch)
nfx_banner; nfx_root_hint

nfx_header "Log inventory (/var/log)"
if [ -d /var/log ]; then
  find /var/log -maxdepth 2 -type f 2>/dev/null | head -400 | while read -r f; do
    s=$(nfx_stat "$f") || continue
    IFS='|' read -r m a c b sz u g md ino nl p <<EOS
$s
EOS
    printf '%-20s %10s %s\n' "$(nfx_epoch_to_iso "$m")" "$sz" "$f"
  done | sort -r | head -120
  nfx_section "zero-byte logs that should normally have content"
  for f in /var/log/wtmp /var/log/btmp /var/log/lastlog /var/log/auth.log /var/log/secure /var/log/syslog /var/log/messages /var/log/kern.log /var/log/system.log /var/log/audit/audit.log /var/log/dpkg.log /var/log/yum.log /var/log/dnf.log /var/log/cron /var/log/faillog /var/log/install.log; do
    [ -e "$f" ] || continue
    sz=$(nfx_stat "$f" | cut -d'|' -f5)
    if [ "$sz" = "0" ]; then nfx_flag "LOG-EMPTY" "$f is 0 bytes"; fi
    [ -L "$f" ] && nfx_flag "LOG-SYMLINK" "$f is a symlink -> $(readlink "$f")"
  done
  nfx_section "logs that stopped updating (mtime older than 7d while system is up)"
  for f in /var/log/syslog /var/log/messages /var/log/auth.log /var/log/secure /var/log/kern.log /var/log/system.log; do
    [ -f "$f" ] || continue
    m=$(nfx_stat "$f" | cut -d'|' -f1)
    [ $((now - m)) -gt 604800 ] && nfx_flag "LOG-STALE" "$f last written $(nfx_epoch_to_iso "$m") - logging stopped or redirected?"
  done
  find /var/log -maxdepth 2 -type l 2>/dev/null | while read -r l; do nfx_info "symlink in /var/log: $l -> $(readlink "$l")"; done
  find /var/log -maxdepth 2 -type f -mmin -"$mins" -size 0 2>/dev/null | grep -vE '\.(gz|xz|journal~?|1|[0-9])$|/lastlog$|/faillog$|btmp' | head -20 | while read -r f; do nfx_info "recently truncated/created empty log: $f"; done
fi

if nfx_is_linux; then
  nfx_header "journald"
  if nfx_have journalctl; then
    journalctl --disk-usage 2>/dev/null
    nfx_section "boots"; journalctl --list-boots --no-pager 2>/dev/null | tail -15
    nfx_section "verify"; journalctl --verify 2>&1 | tail -10
    journalctl --verify 2>&1 | grep -iE 'FAIL|corrupt' | head -5 | while read -r l; do nfx_flag "JOURNAL-CORRUPT" "$l"; done
    first=$(journalctl -q -o short-unix --no-pager 2>/dev/null | head -1 | awk '{print int($1)}')
    [ -n "$first" ] && printf 'earliest entry: %s\n' "$(nfx_epoch_to_iso "$first")"
    nfx_section "gaps > ${GAP}h in the journal (excluding reboots: look for a matching boot)"
    journalctl -q -o short-unix --no-pager 2>/dev/null | awk -v g=$((GAP*3600)) "$NFX_AWK_ISO"'{t=int($1); if (p && t-p>g) printf "gap %6.1fh  %s -> %s\n",(t-p)/3600,iso(p),iso(t); p=t}' | tail -20 |
      while read -r l; do printf '%s\n' "$l"; nfx_flag "LOG-GAP" "journald: $l"; done
    nfx_section "journal config"
    grep -E '^(Storage|MaxRetentionSec|SystemMaxUse|ForwardToSyslog|Seal)' /etc/systemd/journald.conf /etc/systemd/journald.conf.d/* 2>/dev/null
    grep -qE '^Storage=(volatile|none)' /etc/systemd/journald.conf 2>/dev/null && nfx_flag "JOURNAL-VOLATILE" "journald Storage= set to volatile/none (no persistent logs)"
    nfx_section "logging services"
    systemctl is-active systemd-journald rsyslog syslog-ng auditd 2>/dev/null | paste -d' ' - - - - 
    nfx_section "errors/warnings in the last $SINCE (sample)"
    journalctl -q -p warning --since "-${mins}min" --no-pager 2>/dev/null | tail -40
    nfx_section "log-tampering indicators in journal"
    journalctl -q --since "-${mins}min" --no-pager 2>/dev/null | grep -iE 'journal.*(vacuum|rotat)|auditd.*(stop|shut)|rsyslogd.*(exiting|stopped)|Received SIGTERM.*syslog|logrotate' | tail -10
    journalctl -q --no-pager _COMM=journalctl 2>/dev/null | grep -iE 'vacuum' | tail -3 | while read -r l; do nfx_flag "JOURNAL-VACUUM" "$l"; done
  fi
  nfx_header "Syslog gaps > ${GAP}h (/var/log/syslog or messages)"
  for f in /var/log/syslog /var/log/messages; do
    [ -r "$f" ] || continue
    # ISO (rsyslog HighPrecisionTimestamps) or classic "Mon DD HH:MM:SS"
    awk -v g=$((GAP*3600)) -v f="$f" '
      function mon(m){return index("JanFebMarAprMayJunJulAugSepOctNovDec",m)/3+1}
      { if ($1 ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}T/) { split($1,a,/[-T:.+]/); t=a[4]*3600+a[5]*60+a[6]; d=a[3]+0; mo=a[2]+0 }
        else if ($1 ~ /^[A-Z][a-z][a-z]$/) { split($3,b,":"); t=b[1]*3600+b[2]*60+b[3]; d=$2+0; mo=mon($1) }
        else next
        key=mo*31*86400+d*86400+t
        if (p && key-p>g) printf "gap %6.1fh around line %d: %s\n",(key-p)/3600,NR,substr($0,1,60)
        p=key }' "$f" 2>/dev/null | tail -10 | while read -r l; do nfx_flag "LOG-GAP" "$f: $l"; done
    break
  done
  nfx_header "rsyslog / syslog-ng forwarding"
  grep -rhE '^[^#]*(@@?[0-9a-zA-Z\.\-]+:[0-9]+|omfwd|target\()' /etc/rsyslog.conf /etc/rsyslog.d/ /etc/syslog-ng/ 2>/dev/null | head -10
  nfx_header "auditd"
  if [ -r /var/log/audit/audit.log ]; then
    printf 'audit.log: %s\n' "$(nfx_stat_line /var/log/audit/audit.log)"
    nfx_have auditctl && { nfx_section "rules"; auditctl -l 2>/dev/null | head -40; auditctl -s 2>/dev/null; }
    nfx_have aureport && { nfx_section "aureport summary"; aureport --summary 2>/dev/null | head -30; nfx_section "auth failures"; aureport -au --failed 2>/dev/null | tail -15; }
    nfx_have ausearch && { nfx_section "recent execve of interest"; ausearch -m EXECVE -ts recent 2>/dev/null | grep -E 'a0=' | tail -20; }
    grep -E 'type=CONFIG_CHANGE|type=DAEMON_ABORT|type=DAEMON_END' /var/log/audit/audit.log 2>/dev/null | tail -5 | while read -r l; do nfx_info "audit config/daemon event: $l"; done
  else nfx_info "no auditd log"; fi
  nfx_header "dmesg tail"
  (dmesg -T 2>/dev/null || dmesg 2>/dev/null) | tail -25
  if [ -n "$GREP" ]; then
    nfx_header "grep '$GREP' in main logs (last $SINCE)"
    journalctl -q --since "-${mins}min" --no-pager 2>/dev/null | grep -iE "$GREP" | tail -100
    for f in /var/log/syslog /var/log/messages /var/log/auth.log /var/log/secure; do [ -r "$f" ] && grep -iE "$GREP" "$f" | tail -50; done
  fi
else # macOS
  nfx_header "Unified log"
  nfx_have log && { nfx_section "log config"; log config --status 2>/dev/null; }
  nfx_section "persist store"
  du -sh /var/db/diagnostics /var/db/uuidtext 2>/dev/null
  ls -la /var/db/diagnostics/Persist 2>/dev/null | tail -10
  oldest=$(ls -t /var/db/diagnostics/Persist 2>/dev/null | tail -1); [ -n "$oldest" ] && printf 'oldest persist file: %s\n' "$(nfx_stat_line "/var/db/diagnostics/Persist/$oldest")"
  nfx_section "log erase / config changes (last 30d)"
  log show --last 30d --predicate '(process == "log" OR process == "logd") AND (eventMessage CONTAINS[c] "erase" OR eventMessage CONTAINS[c] "purge" OR eventMessage CONTAINS[c] "config")' --style compact 2>/dev/null | tail -20 |
    while read -r l; do printf '%s\n' "$l"; nfx_flag "LOG-ERASE" "$l"; done
  nfx_section "tccd / security events last $SINCE (sample)"
  log show --last "${mins}m" --predicate 'subsystem == "com.apple.TCC" AND eventMessage CONTAINS "Allow"' --style compact 2>/dev/null | tail -20
  nfx_section "errors last $SINCE (sample)"
  log show --last "${mins}m" --predicate 'messageType == error' --style compact 2>/dev/null | tail -30
  nfx_header "Legacy / ASL logs"
  for f in /var/log/system.log /var/log/install.log /var/log/wifi.log /var/log/fsck_apfs.log /var/log/appfirewall.log; do [ -e "$f" ] && nfx_stat_line "$f"; done
  ls -la /var/log/asl 2>/dev/null | tail -5
  nfx_header "Crash / diagnostic reports (last $SINCE)"
  find /Library/Logs/DiagnosticReports /Users/*/Library/Logs/DiagnosticReports -type f -mmin -"$mins" 2>/dev/null | head -30
  nfx_header "Audit (OpenBSM, deprecated)"
  ls -la /var/audit 2>/dev/null | tail -5
  if [ -n "$GREP" ]; then nfx_header "grep '$GREP' in unified log (last $SINCE)"; log show --last "${mins}m" --style compact 2>/dev/null | grep -iE "$GREP" | tail -100; fi
fi
nfx_findings_summary
